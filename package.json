{
  "name": "dsh-node-accent",
  "version": "0.1.0",
  "description": "Recolor only the icon and title text of DSH web conversation rows, per tool or per event category, without rails or background tints.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.naming.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:host": "tsdown --config tsdown.host.config.ts",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "build": "pnpm run build:host && pnpm run build:client",
    "test": "node --test tests/*.test.ts",
    "check:client": "node scripts/check-client.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:client"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.2 <0.2.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.2 <0.2.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "web-ui",
    "conversation",
    "color",
    "accent"
  ]
}
